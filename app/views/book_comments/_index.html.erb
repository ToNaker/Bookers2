<%# app/views/book_comments/_index.html.erb %>

<table class="table">
  <tbody>
    <% book.book_comments.order(created_at: :desc).each do |c| %>
      <tr>
        <td style="width: 180px;">
          <%= link_to c.user.name, user_path(c.user) %>
        </td>

        <td>
          <%= c.comment %>
        </td>

        <td class="text-end" style="white-space: nowrap; width: 120px;">
          <% if c.user == current_user %>
            <%= link_to "Destroy",
                        book_book_comment_path(book, c),
                        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                        class: "btn btn-danger btn-sm" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
