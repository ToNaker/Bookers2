<% if @book_comment.errors.any? %>
  <%= turbo_stream.replace dom_id(@book, :comment_form) do %>
    <%= render "book_comments/form", book: @book, book_comment: @book_comment %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@book, :comments) do %>
    <%= render "book_comments/index", book: @book %>
  <% end %>

  <%= turbo_stream.replace dom_id(@book, :comment_form) do %>
    <%= render "book_comments/form", book: @book, book_comment: BookComment.new %>
  <% end %>

  <%= turbo_stream.replace dom_id(@book, :favorite) do %>
    <%= render "favorites/button", book: @book %>
  <% end %>
<% end %>
