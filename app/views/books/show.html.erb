<!-- app/views/books/show.html.erb -->
<div>
  <div class="row">
    <!-- 左：User info + New book -->
    <div class="col-md-3">
      <%= render "users/userinfo", user: @book_detail.user %>
      <%= render "books/newbook", book: @book %>
    </div>

    <!-- 右：Book detail -->
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>

      <!-- ★ここを追加：見出し直下に横線（参考画像の位置） -->
      <hr class="mt-0 mb-3">

      <!-- ★Book detailの内容（青枠部分）をこの横線の下に置く -->
      <table class="table table-borderless align-middle mb-3">
        <tr>
          <!-- 投稿者（画像＋名前） -->
          <td style="width: 140px;">
            <%= link_to user_path(@book_detail.user), aria: { label: "user profile" } do %>
              <% if @book_detail.user.profile_image.attached? %>
                <%= image_tag @book_detail.user.profile_image, size: "100x100" %>
              <% else %>
                <%= image_tag "no_image.jpg", size: "100x100" %>
              <% end %>
            <% end %>

            <div class="mt-1">
              <%= link_to @book_detail.user.name, user_path(@book_detail.user) %>
            </div>
          </td>

          <!-- title -->
          <td style="width: 25%;">
            <%= link_to @book_detail.title, book_path(@book_detail) %>
          </td>

          <!-- opinion -->
          <td>
            <%= @book_detail.body %>
          </td>

          <!-- ♡（ここにコメント数も置きたいなら後で足せる） -->
          <td class="text-nowrap">
            <span class="me-6">
              <%= render "favorites/button", book: @book_detail %>
            </span>
          </td>
        </tr>
      </table>

      <!-- コメント一覧 -->
      <%= render "book_comments/index", book: @book_detail %>

      <!-- コメント投稿フォーム -->
      <div class="mt-3">
        <%= render "book_comments/form",
                   book: @book_detail,
                   book_comment: @book_comment %>
      </div>
    </div>
  </div>
</div>
