<%# locals: user %>
<% return if user == current_user %>

<% if current_user.following?(user) %>
  <%= link_to "フォロー外す",
              user_relationship_path(user),
              data: { turbo_method: :delete } %>
<% else %>
  <%= link_to "フォローする",
              user_relationship_path(user),
              data: { turbo_method: :post } %>
<% end %>
