<div class="container">
  <h2>Search Results</h2>

  <p class="text-muted mb-3">
    model: <%= @model %> / method: <%= @method %> / word: <%= @word %>
  </p>

  <% if @records.blank? %>
    <p>該当なし</p>
  <% else %>
    <% if @model == "user" %>
      <table class="table">
        <thead>
          <tr>
            <th>name</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @records.each do |user| %>
            <tr>
              <td><%= user.name %></td>
              <td><%= link_to "Show", user_path(user) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

    <% elsif @model == "book" %>
      <h2>Books</h2>

      <table class="table">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>

        <tbody>
          <% @records.each do |book| %>
            <tr>
              <!-- 投稿者画像（参考に寄せて no_image 固定） -->
              <td style="width: 90px;">
                <%= link_to user_path(book.user), aria: { label: "user profile" } do %>
                  <%= image_tag "no_image.jpg", size: "80x80" %>
                <% end %>
              </td>

              <!-- Title -->
              <td>
                <%= link_to book.title, book_path(book) %>
              </td>

              <!-- Opinion（= body） -->
              <td>
                <%= book.body %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</div>