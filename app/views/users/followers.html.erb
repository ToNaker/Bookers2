<div class="container mt-4">
  <div class="row">
    <div class="col-md-3">
      <%= render "books/list", user: current_user, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2><%= @user.name %> の Followers</h2>

      <table class="table">
        <thead>
          <tr>
            <th>image</th>
            <th>name</th>
            <th>フォロー数</th>
            <th>フォロワー数</th>
            <th></th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= image_tag "no_image.jpg", size: "40x40" %></td>
              <td><%= user.name %></td>

              <td>
                フォロー数:
                <%= link_to user.followings.count, followings_user_path(user) %>
              </td>

              <td>
                フォロワー数:
                <%= link_to user.followers.count, followers_user_path(user) %>
              </td>

              <td class="text-nowrap">
                <%= render "relationships/button", user: user %>
              </td>

              <td><%= link_to "Show", user_path(user) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
